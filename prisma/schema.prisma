generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WhatsAppSessionStatus {
  DISCONNECTED
  CONNECTING
  QR_READY
  CONNECTED
  RECONNECTING
  LOGGED_OUT
  ERROR
}

enum PlanCode {
  FREE
  PRO
  ENTERPRISE
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  plan      PlanCode @default(FREE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts WhatsAppAccount[]
}

model WhatsAppAccount {
  id               String                @id @default(uuid())
  userId           String
  label            String
  phoneNumber      String?
  status           WhatsAppSessionStatus @default(DISCONNECTED)
  qrCodeDataUrl    String?
  busyAutoReply    String?
  autoRejectCalls  Boolean               @default(false)
  lastConnectedAt  DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  auth     BaileysAuthState?
  messages WhatsAppMessage[]
  calls    WhatsAppCallEvent[]

  @@index([userId])
  @@index([status])
}

model BaileysAuthState {
  accountId String   @id
  creds     Json
  keys      Json
  version   Int      @default(1)
  updatedAt DateTime @updatedAt

  account WhatsAppAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model WhatsAppMessage {
  id                String   @id @default(uuid())
  accountId         String
  waMessageId       String
  remoteJid         String
  participant       String?
  fromMe            Boolean  @default(false)
  messageTimestamp  BigInt?
  messageType       String?
  pushName          String?
  payload           Json
  isDeletedBySender Boolean  @default(false)
  deletedAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  account WhatsAppAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, waMessageId])
  @@index([accountId, remoteJid])
  @@index([accountId, isDeletedBySender])
}

model WhatsAppCallEvent {
  id        String   @id @default(uuid())
  accountId String
  callId    String
  fromJid   String
  status    String
  isVideo   Boolean  @default(false)
  payload   Json
  createdAt DateTime @default(now())

  account WhatsAppAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, fromJid])
}
